# LorryCarry mobile (Expo) — build-time configuration.
#
# Copy to `.env` (git-ignored) or provide via EAS secrets. Expo inlines every
# `EXPO_PUBLIC_*` variable into the JS bundle at build/start time, so restart
# `expo start` after changing them. Never put secrets here — they ship to users.

# ── API ──────────────────────────────────────────────────────────────────────
# NestJS API base URL INCLUDING the `/api/v1` prefix.
#   iOS simulator            → http://localhost:3002/api/v1
#   Android emulator         → http://10.0.2.2:3002/api/v1
#   Physical device (LAN)    → http://<your-machine-lan-ip>:3002/api/v1
#   Production               → https://api.your-domain.com/api/v1
EXPO_PUBLIC_API_URL=http://localhost:3002/api/v1

# ── Web app ──────────────────────────────────────────────────────────────────
# Public origin of apps/web. Used for "continue in browser" hand-offs:
#   • Cashfree / Razorpay subscription checkout (their SDKs are not bundled in
#     this app, so the user completes payment on `${EXPO_PUBLIC_WEB_URL}/subscribe`
#     and the app confirms activation via GET /subscriptions/status).
#   • The Help centre link.
# Must match CLIENT_URL on the API so gateway return URLs land on the same site.
EXPO_PUBLIC_WEB_URL=http://localhost:3010

# ── Support contacts (optional) ──────────────────────────────────────────────
# When set, Help and Driver Mode show call / WhatsApp / email actions. When
# absent the app says support contacts are not configured instead of showing a
# placeholder number.
EXPO_PUBLIC_SUPPORT_PHONE=+918072025106
EXPO_PUBLIC_SUPPORT_EMAIL=
