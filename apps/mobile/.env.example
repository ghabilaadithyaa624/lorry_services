# LorryCarry mobile — Expo public runtime config.
# Copy to `.env` (or set in your EAS build profile). Every variable must be
# prefixed with EXPO_PUBLIC_ to be inlined into the app bundle.
#
# NOTE: these values are visible in the shipped bundle. Never put secrets
# (gateway secret keys, JWT secrets, DB URLs) here.

# Base URL of the NestJS API, including the /api/v1 prefix.
# Defaults to http://localhost:3002/api/v1 (http://10.0.2.2:3002/api/v1 on Android emulators).
EXPO_PUBLIC_API_URL=http://localhost:3002/api/v1

# Base URL of the LorryCarry web app. Used for the "continue in browser"
# subscription checkout handoff and for web-only workflows.
EXPO_PUBLIC_WEB_URL=http://localhost:3010

# Payment gateway the API is configured with (must match the API's
# PAYMENT_PROVIDER env var): cashfree | razorpay | stripe.
# - stripe   -> the API returns an openable checkout URL, used directly.
# - cashfree/razorpay -> SDK-only payloads, so the app hands off to the web checkout.
EXPO_PUBLIC_PAYMENT_PROVIDER=cashfree

# Support contact details surfaced on the Help and Driver Mode screens.
# Leave EXPO_PUBLIC_SUPPORT_PHONE empty to hide WhatsApp/call support.
EXPO_PUBLIC_SUPPORT_PHONE=
EXPO_PUBLIC_SUPPORT_EMAIL=support@lorrycarry.com
