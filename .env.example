# Database
DATABASE_URL="postgresql://lorrycarry:localdev@localhost:5432/lorrycarry_dev"

# Redis (for rate limiting & OTP storage)
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"
JWT_EXPIRY="15m"
JWT_REFRESH_SECRET="your-refresh-secret-different-from-main"

# MSG91 SMS OTP (https://msg91.com)
MSG91_API_KEY=""
MSG91_SENDER_ID="LORRYC"
MSG91_TEMPLATE_ID=""

# Gupshup WhatsApp API (https://gupshup.io)
GUPSHUP_APP_ID=""
GUPSHUP_APP_TOKEN=""
GUPSHUP_PHONE_NUMBER="" # Your WhatsApp Business number
GUPSHUP_WEBHOOK_SECRET="webhook-secret-change-me"

# MapmyIndia / Mappls (https://mappls.com)
MAPMYINDIA_API_KEY=""
MAPMYINDIA_CLIENT_ID=""
MAPMYINDIA_CLIENT_SECRET=""
ENABLE_GEOCODE_DEV_FALLBACK="false" # Set true ONLY for offline dev testing; NEVER in production

# Cashfree Payments (https://cashfree.com)
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
CASHFREE_WEBHOOK_SECRET="cashfree-webhook-secret"
CASHFREE_BASE_URL="https://sandbox.cashfree.com/pg" # Use prod URL in production

# AWS S3 (or use Minio for local dev)
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="lorrycarry-kyc"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_ENDPOINT="" # Minio for local dev
AWS_S3_FORCE_PATH_STYLE="false" # Required for Minio

# Sentry Error Tracking (optional)
SENTRY_DSN=""

# Client URLs
CLIENT_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3001"
API_URL="http://localhost:3002"
