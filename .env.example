DATABASE_URL="postgresql://lorrycarry:localdev@localhost:5438/lorrycarry_dev?schema=public"
# Prisma `directUrl` — same server for local dev; set to the direct (non-pooled)
# connection string when DATABASE_URL points at a pgbouncer/Supabase pooler.
DIRECT_URL="postgresql://lorrycarry:localdev@localhost:5438/lorrycarry_dev?schema=public"
JWT_SECRET="local-jwt-secret-do-not-use-in-prod"
JWT_REFRESH_SECRET="local-refresh-secret-do-not-use-in-prod"
REDIS_HOST="localhost"
REDIS_PORT=6388
CORS_ORIGIN="http://localhost:3000,http://localhost:3001,http://localhost:3010,http://localhost:3011"
MAPPLS_API_KEY=""
# Optional: MAPMYINDIA_API_KEY is read first when set (alias), then MAPPLS_API_KEY.
GUPSHUP_APP_ID=""
GUPSHUP_APP_TOKEN=""
GUPSHUP_SENDER="919876543210"
# ── MSG91 (SMS OTP) ─────────────────────────────────────────────────────────
# Fallback SMS provider when Gupshup WhatsApp is unavailable/unconfigured.
MSG91_API_KEY=""
# Return the static dev OTP 123456 for any phone in non-production when "true"
# (already automatic when no SMS provider is configured or phone is +918072025106).
ALLOW_TEST_OTP="false"
# ── Vahan (mParivahan) RC Validation ─────────────────────────────────────────
# API key for a Vahan data provider (Surepass-style rc-full endpoint by default).
VAHAN_API_KEY=""
# Optional: override the provider endpoint (POST { id_number } with Bearer auth).
# VAHAN_API_URL="https://kyc-api.surepass.io/api/v1/vehicle-rc/rc-full"
# Deterministic sandbox RC data when no API key is set. Auto-disabled in
# production; set to "false" to force-disable in dev too.
# VAHAN_ALLOW_SANDBOX="true"
# Registration numbers that should resolve as NOT FOUND in sandbox mode (comma separated).
# VAHAN_SANDBOX_INVALID="MH01XX0000"
# In-memory cache TTL (hours) for RC validation results.
# VAHAN_CACHE_TTL_HOURS="6"
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
CASHFREE_ENV="sandbox"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
AWS_S3_BUCKET_NAME="lorrycarry-local"
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="minioadmin"
AWS_SECRET_ACCESS_KEY="minioadmin"
S3_ENDPOINT="http://localhost:9008"
API_URL="http://localhost:3002"
CLIENT_URL="http://localhost:3010"
