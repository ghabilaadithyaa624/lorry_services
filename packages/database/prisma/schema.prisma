generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Users with role-based access
model User {
  id        String   @id @default(uuid())
  phone     String   @unique
  name      String?
  role      UserRole
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 3-month free trial entitlement. One trial per account, granted lazily on
  // first entitlement lookup (or at registration) and never re-issued.
  trialStartedAt   DateTime? @map("trial_started_at")
  trialEndsAt      DateTime? @map("trial_ends_at")
  trialConvertedAt DateTime? @map("trial_converted_at") // set when user upgrades to a paid plan
  
  loads                Load[]
  trucks               Truck[]
  subscriptions        Subscription[]
  loadOwnerBookings    Booking[] @relation("LoadOwnerBookings")
  truckOwnerBookings   Booking[] @relation("TruckOwnerBookings")
  payments             Payment[]
  notifications        Notification[]
  notificationReceipts NotificationReceipt[]
  preference           UserPreference?
  givenRatings         Rating[] @relation("RaterRatings")
  receivedRatings      Rating[] @relation("RatedRatings")
  disputesRaised     BookingDispute[] @relation("DisputesRaised")
  disputesResolved   BookingDispute[] @relation("DisputesResolved")
  bookingDocumentsUploaded BookingDocument[] @relation("BookingDocumentsUploaded")
  bookingDocumentsVerified BookingDocument[] @relation("BookingDocumentsVerified")
  
  @@index([phone])
  @@index([role])
  @@index([trialEndsAt])
  @@map("users")
}

/// Per-user application preferences (theme, locale, units, notification opt-ins).
/// Additive: absence of a row simply means "all defaults", so existing users are
/// unaffected and no backfill is required.
model UserPreference {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")

  // Appearance
  theme        String @default("system") // 'light' | 'dark' | 'system'
  language     String @default("en")
  currency     String @default("INR")
  distanceUnit String @default("km") @map("distance_unit") // 'km' | 'mi'

  // Notification channel opt-ins. Delivery still depends on provider config.
  notifyWhatsapp    Boolean @default(true) @map("notify_whatsapp")
  notifySms         Boolean @default(true) @map("notify_sms")
  notifyPush        Boolean @default(true) @map("notify_push")
  notifyCheckpoints Boolean @default(true) @map("notify_checkpoints")

  // Search defaults
  defaultRadiusKm   Int     @default(50) @map("default_radius_km")
  preferredBodyType String? @map("preferred_body_type")
  autoDetectLocation Boolean @default(true) @map("auto_detect_location")

  // Privacy
  profileVisible Boolean @default(true) @map("profile_visible")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

/// Read receipts for notifications.
///
/// The notification feed mixes persisted `Notification` rows with alerts derived
/// at request time from domain state (pending KYC, unconfirmed advances,
/// checkpoint crossings). A receipt keyed by an opaque string therefore covers
/// BOTH kinds uniformly, instead of only working for stored rows.
model NotificationReceipt {
  id     String @id @default(uuid())
  userId String @map("user_id")

  /// Stable identifier of the notification (DB id, or derived key such as
  /// `notif-kyc-pending-<truckId>`).
  notificationKey String   @map("notification_key")
  readAt          DateTime @default(now()) @map("read_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationKey])
  @@index([userId])
  @@map("notification_receipts")
}

/// Canonical user roles (see docs/database-schema-design.md).
/// Legacy values `load_owner` / `truck_owner` were renamed in place to
/// `factory_owner` / `truck_driver`, and `driver` rows were migrated to
/// `truck_driver` by migration 20260904000000_canonicalize_user_roles.
enum UserRole {
  /// Factory owners / shippers who post freight requirements.
  factory_owner
  /// Truck drivers / fleet operators who list vehicles and run trips.
  truck_driver
  /// Platform operators.
  admin
}

// Subscription paywall
model Subscription {
  id              String             @id @default(uuid())
  userId          String             @map("user_id")
  plan            String // 'monthly' | 'quarterly' | 'annual' — see SUBSCRIPTION_PLANS in @lorrycarry/shared
  status          SubscriptionStatus
  startedAt       DateTime           @map("started_at")
  /// Hard expiry timestamp — the paywall gate compares `now() > expiresAt`
  /// to decide whether contact-reveal / booking creation stays unlocked.
  expiresAt       DateTime           @map("expires_at")
  /// Whether Cashfree should attempt an automatic renewal charge when this
  /// subscription approaches `expiresAt`.
  autoRenew       Boolean            @default(false) @map("auto_renew")
  paymentId       String?            @map("payment_id")
  provider        String             @default("cashfree") // 'cashfree' | 'razorpay' | 'stripe'
  providerOrderId String?            @map("provider_order_id") // Gateway order/session id
  createdAt       DateTime           @default(now()) @map("created_at")
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([status])
  @@index([providerOrderId])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  active
  expired
  cancelled
}

// Load postings with geospatial data
model Load {
  id                 String     @id @default(uuid())
  userId             String     @map("user_id")
  tonnageRequired    Decimal    @map("tonnage_required") @db.Decimal(10, 2)
  loadingAddress     String     @map("loading_address")
  loadingPin         String     @map("loading_pin")
  loadingLat         Decimal?   @map("loading_lat") @db.Decimal(10, 8)
  loadingLng         Decimal?   @map("loading_lng") @db.Decimal(11, 8)
  loadingPoint       Unsupported("geography(Point, 4326)")? @map("loading_point")
  unloadingAddress   String     @map("unloading_address")
  unloadingPin       String     @map("unloading_pin")
  unloadingLat       Decimal?   @map("unloading_lat") @db.Decimal(10, 8)
  unloadingLng       Decimal?   @map("unloading_lng") @db.Decimal(11, 8)
  unloadingPoint     Unsupported("geography(Point, 4326)")? @map("unloading_point")
  truckType          TruckType  @map("truck_type")
  minLengthFt        Int?       @map("min_length_ft")
  minHeightFt        Int?       @map("min_height_ft")
  urgent             Boolean    @default(false)
  maxPrice           Decimal?   @map("max_price") @db.Decimal(12, 2)
  expectedDeliveryAt DateTime?  @map("expected_delivery_at")
  advancePayable     Decimal?   @map("advance_payable") @db.Decimal(12, 2)
  status             LoadStatus @default(Open)
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]
  matches  Match[]
  
  @@index([userId])
  @@index([status])
  @@index([truckType])
  @@index([urgent])
  @@index([createdAt])
  // GiST indexes for geospatial queries (created via migration)
  @@map("loads")
}

enum TruckType {
  Open
  Container
  OpenBody @map("Open body")
}

enum LoadStatus {
  Open
  Matched
  InTransit @map("In-transit")
  Completed
  Cancelled
}

// ── Verification & Compliance ──────────────────────────────────────────────
/// FASTag toll-readiness status for a truck. `Unknown` until the owner or an
/// admin confirms it; derived/manual — Vahan does not expose FASTag state.
enum FastagStatus {
  Unknown
  Active
  LowBalance
  Inactive
}

/// Lifecycle of the E-Way Bill attached to a booking. `Expired`/`Invalid` are
/// computed when the checklist is read or when the record is updated.
enum EwayBillStatus {
  Pending
  Active
  Expired
  Invalid
}

// Truck registrations with geospatial
model Truck {
  id                  String             @id @default(uuid())
  userId              String             @map("user_id")
  registrationNumber  String             @unique @map("registration_number")
  bodyType            TruckType          @map("body_type")
  lengthFt            Int                @map("length_ft")
  heightFt            Int                @map("height_ft")
  tonnageCapacity     Decimal            @map("tonnage_capacity") @db.Decimal(10, 2)
  currentLat          Decimal?           @map("current_lat") @db.Decimal(10, 8)
  currentLng          Decimal?           @map("current_lng") @db.Decimal(11, 8)
  currentLocation     Unsupported("geography(Point, 4326)")? @map("current_location")
  serviceableRadiusKm Int                @default(50) @map("serviceable_radius_km")
  preferredDestinations Json?            @map("preferred_destinations") // Array of city names
  verificationStatus  VerificationStatus @default(Pending) @map("verification_status")
  verifiedAt          DateTime?          @map("verified_at")
  /// Last successful RC validation snapshot from the Vahan (mParivahan) API.
  vahanDetails        Json?              @map("vahan_details")
  vahanValidatedAt    DateTime?          @map("vahan_validated_at")
  vahanStatus         VahanCheckStatus   @default(NotChecked) @map("vahan_status")
  vahanLastCheckedAt  DateTime?          @map("vahan_last_checked_at")
  vahanVerifiedAt     DateTime?          @map("vahan_verified_at")
  vahanResponse       Json?              @map("vahan_response")
  /// FASTag toll-readiness (Active / LowBalance / Inactive / Unknown).
  fastagStatus        FastagStatus       @default(Unknown) @map("fastag_status")
  fastagUpdatedAt     DateTime?          @map("fastag_updated_at")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents Document[]
  bookings  Booking[]
  matches   Match[]
  
  @@index([userId])
  @@index([verificationStatus])
  @@index([vahanValidatedAt])
  @@index([fastagStatus])
  @@index([bodyType])
  @@index([tonnageCapacity])
  @@map("trucks")
}

enum VerificationStatus {
  Pending
  Verified
  Rejected
}

/// Result of the external Parivahan / Vahan registration lookup.
/// `Unavailable` is explicit when provider credentials are not configured;
/// it must never be presented as a successful government verification.
enum VahanCheckStatus {
  NotChecked
  Pending
  Verified
  Mismatch
  Unavailable
  Error
}

// KYC documents (RC, Insurance)
model Document {
  id                 String             @id @default(uuid())
  truckId            String             @map("truck_id")
  type               DocumentType
  docNumber          String?            @map("doc_number")
  s3Url              String             @map("s3_url")
  s3Key              String             @map("s3_key")
  originalFilename   String?            @map("original_filename")
  fileSize           Int?               @map("file_size")
  mimeType           String?            @map("mime_type")
  verificationStatus VerificationStatus @default(Pending) @map("verification_status")
  /// Convenience flag mirroring verificationStatus === Verified, so callers
  /// (e.g. the RC verification badge on Truck/Document lists) can filter
  /// without re-deriving the enum comparison everywhere.
  isVerified         Boolean            @default(false) @map("is_verified")
  verifiedBy         String?            @map("verified_by") // Admin user ID
  verificationNotes  String?            @map("verification_notes")
  verifiedAt         DateTime?          @map("verified_at")
  /// RC fitness-certificate expiry / Insurance policy expiry date, whichever
  /// applies to `type`. Used to proactively flag documents nearing expiry.
  expiryDate         DateTime?          @map("expiry_date")
  createdAt          DateTime           @default(now()) @map("created_at")
  
  truck Truck @relation(fields: [truckId], references: [id], onDelete: Cascade)
  
  @@index([truckId])
  @@index([type])
  @@index([verificationStatus])
  @@index([expiryDate])
  @@map("documents")
}

enum DocumentType {
  RC
  Insurance
}

// Bookings with commercial terms
model Booking {
  id                  String          @id @default(uuid())
  loadId              String          @map("load_id")
  truckId             String          @map("truck_id")
  loadOwnerId         String          @map("load_owner_id")
  truckOwnerId        String          @map("truck_owner_id")
  agreedPrice         Decimal         @map("agreed_price") @db.Decimal(12, 2)
  advanceConfirmed    Boolean         @default(false) @map("advance_confirmed")
  advanceConfirmedAt  DateTime?       @map("advance_confirmed_at")
  balanceConfirmed    Boolean         @default(false) @map("balance_confirmed")
  balanceConfirmedAt  DateTime?       @map("balance_confirmed_at")
  ewayBillNumber      String?         @map("eway_bill_number")
  /// Lifecycle status of the attached E-Way Bill (see EwayBillStatus).
  ewayBillStatus      EwayBillStatus  @default(Pending) @map("eway_bill_status")
  ewayBillValidUpto   DateTime?       @map("eway_bill_valid_upto")
  ewayBillUpdatedAt   DateTime?       @map("eway_bill_updated_at")
  liabilityAccepted   Boolean         @default(false) @map("liability_accepted")
  liabilityAcceptedAt DateTime?       @map("liability_accepted_at")
  status              BookingStatus   @default(Pending)
  startedAt           DateTime?       @map("started_at")
  completedAt         DateTime?       @map("completed_at")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  whatsappTriggerStatus WhatsappTriggerStatus @default(NotTriggered) @map("whatsapp_trigger_status")
  whatsappTriggeredAt   DateTime?             @map("whatsapp_triggered_at")
  
  load        Load         @relation(fields: [loadId], references: [id])
  truck       Truck        @relation(fields: [truckId], references: [id])
  loadOwner   User         @relation("LoadOwnerBookings", fields: [loadOwnerId], references: [id])
  truckOwner  User         @relation("TruckOwnerBookings", fields: [truckOwnerId], references: [id])
  checkpoints      Checkpoint[]
  matches          Match[]
  payments         Payment[]
  ratings          Rating[]
  disputes         BookingDispute[]
  bookingDocuments BookingDocument[]
  
  @@index([loadId])
  @@index([truckId])
  @@index([status])
  @@index([ewayBillStatus])
  @@index([loadOwnerId])
  @@index([truckOwnerId])
  @@index([whatsappTriggerStatus])
  @@map("bookings")
}

enum WhatsappTriggerStatus {
  NotTriggered
  Queued
  Sent
  Delivered
  Failed
}

enum BookingStatus {
  Pending
  Confirmed
  InTransit @map("In-transit")
  Completed
  Cancelled
}

/// A counterparty-reported booking issue that can be investigated and resolved
/// by an administrator. Disputes are additive so existing bookings remain valid.
model BookingDispute {
  id           String          @id @default(uuid())
  bookingId    String          @map("booking_id")
  raisedById   String          @map("raised_by_id")
  category     DisputeCategory  @default(Other)
  priority     DisputePriority  @default(Medium)
  status       DisputeStatus    @default(Open)
  description  String
  resolution   String?
  resolvedById String?          @map("resolved_by_id")
  resolvedAt   DateTime?        @map("resolved_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  raisedBy   User    @relation("DisputesRaised", fields: [raisedById], references: [id])
  resolvedBy User?   @relation("DisputesResolved", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([raisedById])
  @@index([status])
  @@index([priority])
  @@map("booking_disputes")
}

enum DisputeCategory {
  Payment
  CargoDamage @map("Cargo_Damage")
  Delay
  Document
  Other
}

enum DisputePriority {
  Low
  Medium
  High
  Critical
}

enum DisputeStatus {
  Open
  Investigating
  Resolved
  Rejected
}

// ── Booking Digital Document Chain ─────────────────────────────────────────
/// Stage of a booking's 7-stage freight document chain. Stages are additive
/// and shared by both counterparties (factory owner & truck driver).
enum BookingDocumentStage {
  /// Booking advice / lorry receipt & freight contract
  BOOKING
  /// E-Way Bill (GSTN) — Part-A/B assignment for the trip
  EWAY_BILL
  /// Loading slip & weighment / payload inspection report
  LOADING
  /// National transit checkpoint pass / corridor crossing log
  TRANSIT
  /// Arrival gate pass & unloading slip at the destination
  DELIVERY
  /// Proof of Delivery — consignee sign-off & photo evidence
  POD
  /// Balance payment receipt & commercial tax invoice
  BALANCE
}

/// A file attached to a booking within its digital document chain.
///
/// Files live in private object storage (AWS S3 / MinIO); only the object key
/// is persisted here. Uploads and downloads flow through short-lived,
/// server-issued pre-signed URLs, so storage credentials never reach clients.
/// Multiple documents per stage are allowed (e.g. several loading slips);
/// verification is performed by an admin, mirroring truck KYC documents.
model BookingDocument {
  id                 String             @id @default(uuid())
  bookingId          String             @map("booking_id")
  stage              BookingDocumentStage
  /// Reference number captured at upload time (LR no., EWB-12-digit, invoice
  /// no., …). Never auto-fabricated by the server.
  docNumber          String?            @map("doc_number")
  s3Key              String             @map("s3_key")
  originalFilename   String?            @map("original_filename")
  mimeType           String?            @map("mime_type")
  fileSize           Int?               @map("file_size")
  /// Person who signed / owns the document (e.g. consignee for the POD).
  signedBy           String?            @map("signed_by")
  uploadedById       String             @map("uploaded_by_id")
  verificationStatus VerificationStatus @default(Pending) @map("verification_status")
  verifiedById       String?            @map("verified_by_id")
  verificationNotes  String?            @map("verification_notes")
  verifiedAt         DateTime?          @map("verified_at")
  /// Server-side timestamp of the confirmed upload.
  uploadedAt         DateTime           @default(now()) @map("uploaded_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation("BookingDocumentsUploaded", fields: [uploadedById], references: [id])
  verifiedBy User?   @relation("BookingDocumentsVerified", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([bookingId, stage])
  @@index([stage])
  @@index([uploadedById])
  @@index([verificationStatus])
  @@map("booking_documents")
}

// Checkpoint-based tracking (NOT live GPS)
model Checkpoint {
  id          String    @id @default(uuid())
  bookingId   String    @map("booking_id")
  seq         Int       // 1, 2, 3, 4, 5 for the 5 checkpoints
  name        String    // e.g., "Pune", "Satara", "Belgavi", "Hubli", "Bangalore"
  lat         Decimal   @db.Decimal(10, 8)
  lng         Decimal   @db.Decimal(11, 8)
  location    Unsupported("geography(Point, 4326)")?
  radiusM     Int       @map("radius_m") // Geofence radius in meters (default 2000m)
  crossedAt   DateTime? @map("crossed_at")
  crossedBy   String?   @map("crossed_by") // Device ID or user ID
  etaMinutes  Int?      @map("eta_minutes") // Calculated ETA at creation
  notifiedAt  DateTime? @map("notified_at") // When WhatsApp/push was sent
  createdAt   DateTime  @default(now()) @map("created_at")
  
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  
  @@unique([bookingId, seq])
  @@index([bookingId])
  @@index([crossedAt])
  @@map("checkpoints")
}

// Payments (subscriptions + bookings)
model Payment {
  id              String          @id @default(uuid())
  userId          String          @map("user_id")
  bookingId       String?         @map("booking_id")
  amount          Decimal         @db.Decimal(12, 2)
  currency        String          @default("INR")
  purpose         PaymentPurpose
  status          PaymentStatus   @default(Pending)
  provider        String          @default("cashfree")
  providerOrderId String?         @map("provider_order_id")
  providerTxnId   String?         @map("provider_txn_id")
  paymentMethod   String?         @map("payment_method") // UPI, CARD, etc.
  paidAt          DateTime?       @map("paid_at")
  failureReason   String?         @map("failure_reason")
  metadata        Json?           // Store additional payment data
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  
  @@index([userId])
  @@index([bookingId])
  @@index([status])
  @@index([providerTxnId])
  @@map("payments")
}

enum PaymentPurpose {
  subscription
  booking_advance
  booking_balance
}

enum PaymentStatus {
  Pending
  Success
  Failed
  Refunded
}

// Notifications (WhatsApp/SMS/Push)
model Notification {
  id          String                @id @default(uuid())
  userId      String                @map("user_id")
  channel     NotificationChannel
  template    String                // Template name/code
  variables   Json?                 // Template variables
  recipient   String                // Phone number or device token
  content     String?               // Actual content sent
  status      NotificationStatus    @default(Pending)
  provider    String                @default("gupshup") // or msg91
  providerMsgId String?             @map("provider_msg_id")
  deliveredAt DateTime?           @map("delivered_at")
  failedAt    DateTime?           @map("failed_at")
  failureReason String?           @map("failure_reason")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([status])
  @@index([channel])
  @@map("notifications")
}

enum NotificationChannel {
  whatsapp
  sms
  push
}

enum NotificationStatus {
  Pending
  Sent
  Delivered
  Failed
}

// Matching Engine — Need Load ↔ Need Vehicle pairing
enum MatchStatus {
  Pending   // Initial algorithmic match, awaiting booking
  Booked    // Load+Truck have a confirmed booking
  Completed // Trip completed / POD confirmed
  Cancelled
}

model Match {
  id               String      @id @default(uuid())
  loadId           String      @map("load_id")
  truckId          String      @map("truck_id")
  loadOwnerId      String      @map("load_owner_id")
  truckOwnerId     String      @map("truck_owner_id")
  bookingId        String?     @map("booking_id")
  status           MatchStatus @default(Pending)
  // Derived compatibility signals
  distanceKm       Decimal?    @map("distance_km") @db.Decimal(10, 2)
  matchScore       Int?        @map("match_score")
  tonnageCompatible Boolean    @default(false) @map("tonnage_compatible")
  routeCompatible   Boolean    @default(false) @map("route_compatible")
  budgetCompatible  Boolean    @default(false) @map("budget_compatible")
  // WhatsApp trigger tracking
  notifiedAt       DateTime?   @map("notified_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  load    Load     @relation(fields: [loadId], references: [id], onDelete: Cascade)
  truck   Truck    @relation(fields: [truckId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@unique([loadId, truckId])
  @@index([loadId])
  @@index([truckId])
  @@index([loadOwnerId])
  @@index([truckOwnerId])
  @@index([status])
  @@index([createdAt])
  @@map("matches")
}

// Ratings for completed trips
model Rating {
  id          String    @id @default(uuid())
  bookingId   String    @map("booking_id")
  raterId     String    @map("rater_id")
  ratedUserId String    @map("rated_user_id")
  rating      Int       // 1-5 stars
  review      String?   @db.Text
  category    RatingCategory @default(overall)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  
  rater     User     @relation("RaterRatings", fields: [raterId], references: [id], onDelete: Cascade)
  ratedUser User     @relation("RatedRatings", fields: [ratedUserId], references: [id], onDelete: Cascade)
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  
  @@unique([bookingId, raterId])
  @@index([raterId])
  @@index([ratedUserId])
  @@map("ratings")
}

enum RatingCategory {
  driver_service  // Factory owner rating driver
  factory_payment // Driver rating factory owner payment behavior
  overall         // General rating
}
